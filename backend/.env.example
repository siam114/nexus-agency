# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI or local instance)
# Local: mongodb://127.0.0.1:27017/nexusagency
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexusagency?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nexusagency

# JWT Secret Key for Administrator Authentication (Use a secure random string)
JWT_SECRET=super_secret_jwt_key_nexusagency_2026_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://nexusagency.com

# Initial Superadmin Credentials (Used when running scripts/seed.ts)
INITIAL_ADMIN_EMAIL=smsiam987@gmail.com
INITIAL_ADMIN_PASSWORD=AdminPassword123!
INITIAL_ADMIN_NAME=SM SIAM

